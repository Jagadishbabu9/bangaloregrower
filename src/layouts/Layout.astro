---
const { title = "Bangalore Grower" } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>

  <meta
    name="description"
    content="An Open Logbook of a Living System of Shared Intelligence."
  />
</head>

<body>

<header>
  <h2><a href="/">Bangalore Grower</a></h2>

  <nav>
    <a href="/">Home</a>
    <a href="/journal">Journal</a>
    <a href="/garden">Garden</a>
    <a href="/nature-ai">Nature AI</a>
    <a href="/family">Family</a>
    <a href="/about">About</a>
  </nav>
</header>

<main>
  <slot />
</main>

<footer>
  <p>Growing together with nature.</p>
</footer>

</body>
</html>

<style>
:root {
  --text: #222;
  --background: #fafaf7;
  --accent: #2f6b3d;
}

body {
  margin: 0;
  font-family: Georgia, serif;
  background: var(--background);
  color: var(--text);
  line-height: 1.7;
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem 3rem;
  border-bottom: 1px solid #ddd;
}

header h2 {
  margin: 0;
}

header a {
  color: inherit;
  text-decoration: none;
}

nav {
  display: flex;
  gap: 1.5rem;
}

main {
  max-width: 760px;
  margin: 5rem auto;
  padding: 0 2rem;
}

h1 {
  font-size: 3rem;
}

footer {
  text-align: center;
  padding: 3rem;
  color: #666;
}
</style>